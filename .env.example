# ══════════════════════════════════════════════════════════════════
# Lenny Growth Assistant — Environment Configuration
# ══════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────
APP_ENV=development
APP_NAME=Lenny Growth Assistant
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────
# SQLite (no installation needed — works out of the box):
DATABASE_URL=sqlite:///./lenny_growth.db

# PostgreSQL (recommended for production — uncomment and edit):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/lenny_growth

# ── LLM Provider ─────────────────────────────────────────────────
# "ollama" (local, free) or "anthropic" (cloud, requires API key)
LLM_PROVIDER=ollama

# ── Ollama (Local LLM — free, runs on your machine) ──────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# ── Anthropic / Claude (Cloud) ────────────────────────────────────
# Set LLM_PROVIDER=anthropic and add your key:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Embeddings ────────────────────────────────────────────────────
# "simple" = TF-IDF (works with no extra setup, default)
# "ollama" = neural embeddings (pull nomic-embed-text first)
EMBEDDING_PROVIDER=simple
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── Retrieval ─────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.05

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Security ──────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
